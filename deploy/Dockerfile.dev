# --- development image ---
FROM python:3.12.13-slim-bookworm

# locale and timezone
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8
ENV TZ=UTC

# set up a virtual environment
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# install system dependencies
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    openssh-server \
    gcc \
    libc6-dev \
    libpq-dev \
    libpq5 \
    git \
    curl \
    less \
    vim \
    procps \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# install uv
COPY --from=ghcr.io/astral-sh/uv:0.11.24 /uv /usr/local/bin/uv

# install ffmpeg and ffprobe
COPY --from=mwader/static-ffmpeg:7.1 /ffprobe /usr/local/bin/ffprobe

# create a non-root user for development
RUN groupadd --gid 1000 dev \
 && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash dev \
 && passwd --delete dev

# configure sshd
RUN mkdir -p /var/run/sshd \
 && passwd --delete root \
 && printf '%s\n' \
      'PermitRootLogin yes' \
      'PasswordAuthentication yes' \
      'PermitEmptyPasswords yes' \
      >> /etc/ssh/sshd_config \
 && printf '%s\n' 'UV_PROJECT_ENVIRONMENT=/opt/venv' > /etc/environment \
 && printf '%s\n' \
      'export PATH="/opt/venv/bin:$PATH"' \
      'cd /home/dev/lectern 2>/dev/null || true' \
      > /etc/profile.d/00-lectern.sh

# install dependencies
WORKDIR /opt/deps
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project \
 && chown -R dev:dev /opt/venv

# where the repository gets mounted
WORKDIR /home/dev/lectern

# expose ssh and the development server port
EXPOSE 22 8000

# run sshd in the foreground
CMD ["/usr/sbin/sshd", "-D", "-e"]
