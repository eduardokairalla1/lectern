# shared secret every
API_KEY=

# one key per model role, so usage and limits can be attributed per call
OPENAI_API_KEY_PRINCIPAL=
OPENAI_API_KEY_MEMORY=
OPENAI_API_KEY_EMBEDDING=
OPENAI_API_KEY_TRANSCRIBE=
OPENAI_API_KEY_REWRITE=

# --- llm models ---
PRINCIPAL_MODEL=gpt-5.4-mini
MEMORY_MODEL=gpt-5.4-mini
REWRITE_MODEL=gpt-5.4-mini
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
EMBEDDING_MODEL=text-embedding-3-small

# comma-separated
CORS_ORIGINS=https://example.com

# -- optional ---
# LOG_LEVEL=DEBUG
# CELERY_CONCURRENCY=2
# MAX_AUDIO_DURATION_SECONDS=120
# MAX_AUDIO_BASE64_SIZE=10485760
