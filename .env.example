# general
ENVIRONMENT=development
LOG_LEVEL=DEBUG
# IDENTITY_FILE=identity.yaml

# server binding
BIND=0.0.0.0
PORT=8000

# celery worker processes
CELERY_CONCURRENCY=2

# openai keys
OPENAI_API_KEY_PRINCIPAL=sk-...
OPENAI_API_KEY_MEMORY=sk-...
OPENAI_API_KEY_EMBEDDING=sk-...
OPENAI_API_KEY_TRANSCRIBE=sk-...
OPENAI_API_KEY_REWRITE=sk-...

# models
PRINCIPAL_MODEL=gpt-4o-mini
MEMORY_MODEL=gpt-4o-mini
REWRITE_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=whisper-1
EMBEDDING_MODEL=text-embedding-3-small

# databases
QDRANT_URL=http://localhost:6333
# VECTOR_COLLECTION=lectern_documents
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/chatbot

# routing
# API_PREFIX=/api

# security
API_KEY=change-me

# audio limits
MAX_AUDIO_DURATION_SECONDS=120
MAX_AUDIO_BASE64_SIZE=10485760

# cors (comma-separated)
CORS_ORIGINS=http://localhost:*
