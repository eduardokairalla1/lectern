# general
ENVIRONMENT=development
LOG_LEVEL=DEBUG
# IDENTITY_FILE=identity.yaml

# server binding
BIND=0.0.0.0
PORT=8000

# celery worker processes
CELERY_CONCURRENCY=2

# openai keys
OPENAI_API_KEY_PRINCIPAL=sk-...
OPENAI_API_KEY_MEMORY=sk-...
OPENAI_API_KEY_EMBEDDING=sk-...
OPENAI_API_KEY_TRANSCRIBE=sk-...
OPENAI_API_KEY_REWRITE=sk-...

# models
PRINCIPAL_MODEL=gpt-5.4-mini
MEMORY_MODEL=gpt-5.4-mini
REWRITE_MODEL=gpt-5.4-mini
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
EMBEDDING_MODEL=text-embedding-3-small

# databases
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://lectern:goodpassword@postgres:5432/lectern

# security
API_KEY=change-me

# audio limits
MAX_AUDIO_DURATION_SECONDS=120
MAX_AUDIO_BASE64_SIZE=10485760

# cors (comma-separated)
CORS_ORIGINS=http://localhost:*
